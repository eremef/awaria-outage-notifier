<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_background"
  android:gravity="center_horizontal"
  android:orientation="vertical"
  android:padding="@dimen/widget_small_padding">

  <TextView
    android:id="@+id/widget_source"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"    
    android:paddingHorizontal="@dimen/widget_small_count_padding_horizontal"
    android:breakStrategy="simple"
    android:hyphenationFrequency="none"
    android:text="@string/label_provider"
    android:textAlignment="center"
    android:textColor="@color/widget_text_label"
    android:textSize="@dimen/widget_small_source_text_size"
    android:textStyle="bold" />

  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1" />

  <TextView
    android:id="@+id/widget_count"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:paddingHorizontal="@dimen/widget_small_count_padding_horizontal"
    android:text="@string/placeholder_dash"
    android:textColor="@color/utility_gas"
    android:textSize="@dimen/widget_small_count_text_size"
    android:textStyle="bold" />

  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1" />

  <TextView
    android:id="@+id/widget_updated"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/placeholder_time"
    android:textColor="@color/widget_text_updated"
    android:textSize="@dimen/widget_small_updated_text_size" />

</LinearLayout>


