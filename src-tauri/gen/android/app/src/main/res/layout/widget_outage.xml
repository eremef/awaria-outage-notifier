<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_background"
  android:gravity="center_horizontal"
  android:orientation="vertical"
  android:padding="4dp">

  <TextView
    android:id="@+id/widget_source"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="0dp"
    android:breakStrategy="simple"
    android:gravity="center"
    android:hyphenationFrequency="none"
    android:text="@string/label_provider"
    android:textAlignment="center"
    android:textColor="@color/widget_text_updated"
    android:textSize="16sp"
    android:textStyle="bold" />

  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1" />

  <ImageView
    android:id="@+id/widget_icon"
    android:layout_width="20dp"
    android:layout_height="20dp"
    android:layout_marginBottom="0dp"
    android:contentDescription="@string/icon_description"
    android:src="@drawable/ic_electricity" />

  <TextView
    android:id="@+id/widget_count"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/placeholder_dash"
    android:textColor="@color/widget_text_primary"
    android:textSize="32sp"
    android:textStyle="bold" />

  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1" />

  <TextView
    android:id="@+id/widget_updated"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="@string/placeholder_time"
    android:textColor="@color/widget_text_updated"
    android:textSize="11sp" />

</LinearLayout>
