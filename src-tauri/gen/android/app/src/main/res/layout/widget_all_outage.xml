<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  tools:ignore="UseAppTint"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_background"
  android:padding="3dp">

  <RelativeLayout
    android:id="@+id/widget_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="1dp"
    android:paddingHorizontal="2dp">

    <TextView
      android:id="@+id/widget_address_name"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_alignParentStart="true"
      android:layout_centerVertical="true"
      android:layout_toStartOf="@+id/widget_updated"
      android:ellipsize="end"
      android:gravity="center"
      android:singleLine="true"
      android:text=""
      android:textColor="@color/widget_text_updated"
      android:textSize="11sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widget_updated"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_alignParentEnd="true"
      android:layout_centerVertical="true"
      android:ellipsize="end"
      android:maxLines="1"
      android:paddingTop="1dp"
      android:text="@string/placeholder_time"
      android:textColor="@color/widget_text_updated"
      android:textSize="8sp" />
  </RelativeLayout>

  <LinearLayout
    android:id="@+id/widget_content_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_below="@id/widget_header"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:weightSum="4">

    <!-- Power -->
    <LinearLayout
      android:id="@+id/section_power"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center"
      android:orientation="vertical">

      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
          android:id="@+id/icon_power"
          android:layout_width="@dimen/address_widget_icon_width"
          android:layout_height="@dimen/address_widget_icon_height"
          android:contentDescription="@null"
          android:tint="@color/utility_power"
          android:src="@drawable/ic_electricity" />

      </LinearLayout>

      <TextView
        android:id="@+id/count_power"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/placeholder_dash"
        android:textColor="@color/utility_power"
        android:textSize="@dimen/address_widget_count_size"
        android:textStyle="bold" />
    </LinearLayout>

    <!-- Heat -->
    <LinearLayout
      android:id="@+id/section_heat"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center"
      android:orientation="vertical">

      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
          android:id="@+id/icon_heat"
          android:layout_width="@dimen/address_widget_icon_width"
          android:layout_height="@dimen/address_widget_icon_height"
          android:contentDescription="@null"
          android:tint="@color/utility_heat"
          android:src="@drawable/ic_heating" />
      </LinearLayout>

      <TextView
        android:id="@+id/count_heat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/placeholder_dash"
        android:textColor="@color/utility_heat"
        android:textSize="@dimen/address_widget_count_size"
        android:textStyle="bold" />
    </LinearLayout>

    <!-- Water -->
    <LinearLayout
      android:id="@+id/section_water"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center"
      android:orientation="vertical">

      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
          android:id="@+id/icon_water"
          android:layout_width="@dimen/address_widget_icon_width"
          android:layout_height="@dimen/address_widget_icon_height"
          android:contentDescription="@null"
          android:tint="@color/utility_water"
          android:src="@drawable/ic_water" />
      </LinearLayout>

      <TextView
        android:id="@+id/count_water"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/placeholder_dash"
        android:textColor="@color/utility_water"
        android:textSize="@dimen/address_widget_count_size"
        android:textStyle="bold" />
    </LinearLayout>

    <!-- Gas -->
    <LinearLayout
      android:id="@+id/section_gas"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center"
      android:orientation="vertical">

      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
          android:id="@+id/icon_gas"
          android:layout_width="@dimen/address_widget_icon_width"
          android:layout_height="@dimen/address_widget_icon_height"
          android:contentDescription="@null"
          android:tint="@color/utility_gas"
          android:src="@drawable/ic_gas" />
      </LinearLayout>

      <TextView
        android:id="@+id/count_gas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/placeholder_dash"
        android:textColor="@color/utility_gas"
        android:textSize="@dimen/address_widget_count_size"
        android:textStyle="bold" />
    </LinearLayout>

  </LinearLayout>

</RelativeLayout>

