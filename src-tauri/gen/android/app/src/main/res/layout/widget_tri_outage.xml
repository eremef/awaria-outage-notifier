<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  tools:ignore="UseAppTint"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@drawable/widget_background"
  android:padding="4dp">

  <RelativeLayout
    android:id="@+id/widget_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="12dp"
    android:paddingHorizontal="10dp">

    <TextView
      android:id="@+id/widget_address_name"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_alignParentStart="true"
      android:layout_centerVertical="true"
      android:layout_toStartOf="@+id/widget_updated"
      android:ellipsize="end"
      android:gravity="start|center_vertical"
      android:maxLines="1"
      android:text=""
      android:textColor="@color/widget_text_updated"
      android:textSize="11sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widget_updated"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_alignParentEnd="true"
      android:layout_centerVertical="true"
      android:ellipsize="end"
      android:maxLines="1"
      android:paddingStart="4dp"
      android:maxWidth="64dp"
      android:text="@string/placeholder_time"
      android:textColor="@color/widget_text_updated"
      android:textSize="10sp"
      android:visibility="visible" />
  </RelativeLayout>

  <LinearLayout
    android:id="@+id/widget_content_container"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:weightSum="3">

    <LinearLayout
      android:id="@+id/section_power"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center"
      android:importantForAccessibility="no"
      android:orientation="vertical">
      <ImageView
        android:id="@+id/icon_power"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_electricity"
        android:scaleType="fitCenter"
        android:tint="@color/utility_power" />
      <TextView
        android:id="@+id/count_power"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autoSizeMaxTextSize="16sp"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/placeholder_dash"
        android:textColor="@color/utility_power"
        android:textSize="16sp"
        android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/section_heat"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center"
      android:importantForAccessibility="no"
      android:orientation="vertical">
      <ImageView
        android:id="@+id/icon_heat"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_heating"
        android:scaleType="fitCenter"
        android:tint="@color/utility_heat" />
      <TextView
        android:id="@+id/count_heat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autoSizeMaxTextSize="16sp"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/placeholder_dash"
        android:textColor="@color/utility_heat"
        android:textSize="16sp"
        android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/section_water"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center"
      android:importantForAccessibility="no"
      android:orientation="vertical">
      <ImageView
        android:id="@+id/icon_water"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_water"
        android:scaleType="fitCenter"
        android:tint="@color/utility_water" />
      <TextView
        android:id="@+id/count_water"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autoSizeMaxTextSize="16sp"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/placeholder_dash"
        android:textColor="@color/utility_water"
        android:textSize="16sp"
        android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
