<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

  <TextView
    android:id="@+id/widget_source"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:breakStrategy="simple"
    android:hyphenationFrequency="none"
    android:text="@string/label_provider"
    android:textAlignment="center"
    android:textColor="@color/widget_text_updated"
    android:textSize="18sp"
    android:textStyle="bold" />

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/ic_electricity"
        android:contentDescription="@string/icon_description" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
  
    <TextView
        android:id="@+id/widget_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/placeholder_dash"
        android:textColor="@color/widget_text_primary"
        android:textSize="48sp"
        android:textStyle="bold" />
  

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_outages"
        android:textColor="@color/widget_text_label"
        android:textSize="20sp" />

    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1" />
  
    <TextView
        android:id="@+id/widget_updated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/placeholder_time"
        android:textColor="@color/widget_text_updated"
        android:textSize="16sp" />

</LinearLayout>
